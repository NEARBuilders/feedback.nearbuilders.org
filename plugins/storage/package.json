{
  "name": "@everything-dev/storage-plugin",
  "version": "1.0.0",
  "description": "Image storage plugin \u2014 presigned R2 uploads with auth, limits and per-uploader keys (#131)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    }
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "aws4fetch": "catalog:",
    "drizzle-orm": "catalog:",
    "@orpc/openapi": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@electric-sql/pglite": "catalog:",
    "@module-federation/node": "catalog:",
    "@proj-airi/unplugin-drizzle-orm-migrations": "^0.1.4",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "^17.2.3",
    "drizzle-kit": "catalog:",
    "everything-dev": "catalog:",
    "every-plugin": "catalog:",
    "pg": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "catalog:",
    "zephyr-rspack-plugin": "catalog:"
  },
  "scripts": {
    "build": "every-plugin build",
    "build:types": "tsc -p tsconfig.contract.json",
    "dev": "every-plugin dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  }
}
