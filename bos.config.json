{
  "extends": "bos://dev.everything.near/dev.everything.dev",
  "account": "nearbuilding.near",
  "domain": "feedback.nearbuilders.org",
 "title": "Feedback | NearBuilders",
  "description": "Request a feedback round, get matched with builders, and turn testing into portable credit.",
  "repository": "https://github.com/NEARBuilders/feedback.nearbuilders.org",
  "ci": {
    "railway": {
      "service": "feedback-app"
    }
  },
  "app": {
    "ui": {
      "development": "local:ui"
    },
    "api": {
      "development": "local:api",
      "secrets": [
        "API_DATABASE_URL",
        "ACTIVITY_API_BASE_URL",
        "ACTIVITY_API_KEY",
        "ACTIVITY_SOURCE_ID"
      ]
    }
  },
  "plugins": {
    "nostr": {
      "extends": "bos://nearbuilding.near/nostr.nearbuilders.org",
      "variables": {
        "clientName": "nearbuilders.org"
      }
    }
  }
}