      "development": "local:plugins/legion",
      "variables": {
        "nodeUrl": "https://rpc.mainnet.near.org",
        "contractIds": [
          "initiate.nearlegion.near",
          "ascendant.nearlegion.near"
        ]
      },
      "production": "https://elliot-braem-9032-everything-dev-legion-plugin-fe-bb004f033-ze.zephyrcloud.app",
      "integrity": "sha384-z5qc4Hrqu7TN4Mq51HHmOAbYHt4qQSv+Wr5xHKTchcgGUAzKxzhbVpDEASVN+dUS"
