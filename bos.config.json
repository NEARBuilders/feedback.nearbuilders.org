{
  "extends": "bos://dev.everything.near/dev.everything.dev",
  "account": "nearbuilding.near",
  "domain": "feedback.nearbuilders.org",
  "title": "Feedback | NearBuilders",
  "description": "Request a feedback round, get matched with builders, and turn testing into portable credit.",
  "repository": "https://github.com/NEARBuilders/feedback.nearbuilders.org",
  "ci": {
    "railway": {
      "service": "feedback-app"
    }
  },
  "app": {
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-9022-ui-feedback-nearbuilders-org-ne-250adcfc8-ze.zephyrcloud.app",
      "integrity": "sha384-Ez3GazOA3T+ev4oxJ68inXJnhqqFXVmXTuyoQYTTk6oTnl1xiXbBbw2Pwvh4M2DH",
      "ssr": "https://elliot-braem-9026-ui-feedback-nearbuilders-org-ne-1357b6fa5-ze.zephyrcloud.app",
      "ssrIntegrity": "sha384-3sb9aO3wTwf0t33QtyeUUaeZoZz6FgDDai7ryBb0yF/lXIpunE4yMSU7VeqqtjzL"
    },
    "api": {
      "development": "local:api",
      "secrets": [
        "API_DATABASE_URL",
        "PROJECTS_API_BASE_URL",
        "ACTIVITY_API_BASE_URL",
        "ACTIVITY_API_KEY",
        "ACTIVITY_SOURCE_ID",
        "NOSTR_SECRET_KEY_HEX",
        "GITHUB_API_TOKEN",
        "TIP_MESSAGE_TEMPLATE"
      ],
      "production": "https://elliot-braem-9025-api-feedback-nearbuilders-org-n-5e40d9dfa-ze.zephyrcloud.app",
      "integrity": "sha384-e1SPJsnkJD6ohJvhLB51zijQt4yzPf8sDBxRrJk3FtDBqsfie2I4xpAQIubOg9Zi"
    }
  },
  "plugins": {
    "legion": {
      "development": "local:plugins/legion",
      "variables": {
        "nodeUrl": "https://rpc.mainnet.near.dev",
        "contractIds": [
          "initiate.nearlegion.near",
          "ascendant.nearlegion.near"
        ]
      },
      "production": "https://elliot-braem-9023-everything-dev-legion-plugin-fe-026d0b067-ze.zephyrcloud.app",
      "integrity": "sha384-z5qc4Hrqu7TN4Mq51HHmOAbYHt4qQSv+Wr5xHKTchcgGUAzKxzhbVpDEASVN+dUS"
    },
    "nostr": {
      "extends": "bos://nearbuilding.near/nostr.nearbuilders.org",
      "variables": {
        "clientName": "nearbuilders.org"
      }
    },
    "storage": {
      "development": "local:plugins/storage",
      "variables": {
        "allowedContentTypes": [
          "image/png",
          "image/jpeg",
          "image/webp",
          "image/gif"
        ],
        "maxUploadBytes": 5242880
      },
      "secrets": [
        "STORAGE_DATABASE_URL",
        "STORAGE_ENDPOINT",
        "STORAGE_BUCKET",
        "STORAGE_REGION",
        "STORAGE_PUBLIC_URL",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY"
      ],
      "production": "https://elliot-braem-9024-everything-dev-storage-plugin-f-57d41667f-ze.zephyrcloud.app",
      "integrity": "sha384-QT5UoGcyJcfxBLJ99mBFlRtHL31MKtQd+rLNw1M4/LVKVGCvSNUxSL7BPGg4Ja+T"
    }
  }
}
