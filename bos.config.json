        "maxUploadBytes": 5242880
      },
      "secrets": [
        "STORAGE_DATABASE_URL",
        "STORAGE_ENDPOINT",
        "STORAGE_BUCKET",
        "STORAGE_REGION",
        "STORAGE_PUBLIC_URL",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY"
      ],
      "production": "https://elliot-braem-9034-everything-dev-storage-plugin-f-fff5de717-ze.zephyrcloud.app",
      "integrity": "sha384-QT5UoGcyJcfxBLJ99mBFlRtHL31MKtQd+rLNw1M4/LVKVGCvSNUxSL7BPGg4Ja+T"
