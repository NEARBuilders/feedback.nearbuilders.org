      "ssrIntegrity": "sha384-LUnMzGPmPPvLLbn3G/pJ749HVajpTKHw3hk/vSjY187nRMhri89ergyR6u2Zwc0c"
    },
    "api": {
      "development": "local:api",
      "secrets": [
