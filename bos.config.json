        "STORAGE_ENDPOINT",
        "STORAGE_BUCKET",
        "STORAGE_REGION",
        "STORAGE_PUBLIC_URL",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY"
      ],
      "production": "https://elliot-braem-9045-everything-dev-storage-plugin-f-22919b2fd-ze.zephyrcloud.app",
      "integrity": "sha384-QT5UoGcyJcfxBLJ99mBFlRtHL31MKtQd+rLNw1M4/LVKVGCvSNUxSL7BPGg4Ja+T"
