        "PROJECTS_API_BASE_URL",
        "ACTIVITY_API_BASE_URL",
        "ACTIVITY_API_KEY",
        "ACTIVITY_SOURCE_ID",
        "NOSTR_SECRET_KEY_HEX",
        "GITHUB_API_TOKEN",
        "TIP_MESSAGE_TEMPLATE"
      ],
      "production": "https://elliot-braem-9033-api-feedback-nearbuilders-org-n-f2c705d9a-ze.zephyrcloud.app",
      "integrity": "sha384-e1SPJsnkJD6ohJvhLB51zijQt4yzPf8sDBxRrJk3FtDBqsfie2I4xpAQIubOg9Zi"
