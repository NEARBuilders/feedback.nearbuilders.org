{
  "extends": "bos://dev.everything.near/dev.everything.dev",
  "account": "nearbuilding.near",
  "domain": "feedback.nearbuilders.org",
  "title": "Feedback | NearBuilders",
  "description": "Request a feedback round, get matched with builders, and turn testing into portable credit.",
  "repository": "https://github.com/NEARBuilders/feedback.nearbuilders.org",
  "ci": {
    "railway": {
      "service": "feedback-app"
    }
  },
  "app": {
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-8801-ui-feedback-nearbuilders-org-ne-a0a4e6725-ze.zephyrcloud.app",
      "integrity": "sha384-LYhvFvVBbcfraaQwEzdmY9P1a25zpQA7HHfkWw2LX3+WeEDAtx7UZlcGUpxMLvd9",
      "ssr": "https://elliot-braem-8803-ui-feedback-nearbuilders-org-ne-df048d35b-ze.zephyrcloud.app",
      "ssrIntegrity": "sha384-3ORA9pB0JfhfBw3BIYtBlRGUoQ6Ouhc9BEmPsSSPU9KGGUQiNnXWaP+QQmIqiRkm"
    },
    "api": {
      "development": "local:api",
      "secrets": [
        "API_DATABASE_URL",
        "PROJECTS_API_BASE_URL",
        "ACTIVITY_API_BASE_URL",
        "ACTIVITY_API_KEY",
        "ACTIVITY_SOURCE_ID"
      ],
      "production": "https://elliot-braem-8802-api-feedback-nearbuilders-org-n-16ac1eb98-ze.zephyrcloud.app",
      "integrity": "sha384-poFLnNwoE9L9aDwtzQzmlvsfG/E8x3TZBSmCRuciQfCoYFgSetcdavVAlM0WyWrP"
    }
  },
  "plugins": {
    "legion": {
      "development": "local:plugins/legion",
      "variables": {
        "nodeUrl": "https://rpc.mainnet.near.dev",
        "contractIds": ["initiate.nearlegion.near", "ascendant.nearlegion.near"]
      }
    },
    "nostr": {
      "extends": "bos://nearbuilding.near/nostr.nearbuilders.org",
      "variables": {
        "clientName": "nearbuilders.org"
      }
    },
    "storage": {
      "development": "local:plugins/storage",
      "variables": {
        "allowedContentTypes": [
          "image/png",
          "image/jpeg",
          "image/webp",
          "image/gif"
        ],
        "maxUploadBytes": 5242880
      },
      "secrets": [
        "STORAGE_DATABASE_URL",
        "STORAGE_ENDPOINT",
        "STORAGE_BUCKET",
        "STORAGE_REGION",
        "STORAGE_PUBLIC_URL",
        "STORAGE_ACCESS_KEY_ID",
        "STORAGE_SECRET_ACCESS_KEY"
      ]
    }
  }
}
